{
  "expo": {
    "name": "OBAMEPortfolio",
    "slug": "obameportfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.obame.portfolio",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OBAMEPortfolio to access your photos to set your profile picture.",
          "cameraPermission": "Allow OBAMEPortfolio to access your camera to take your profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "73c0ec1b-5620-4461-9c67-43db738a6996"
      }
    }
  }
}
